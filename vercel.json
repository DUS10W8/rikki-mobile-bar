{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/drink-checkout.js": {
      "includeFiles": "src/order/*.json"
    },
    "api/walkup-checkout.js": {
      "includeFiles": "src/order/*.json"
    }
  },
  "redirects": [
    {
      "source": "/Pay",
      "destination": "/pay",
      "permanent": false
    },
    {
      "source": "/PAY",
      "destination": "/pay",
      "permanent": false
    },
    {
      "source": "/Register",
      "destination": "/register",
      "permanent": false
    },
    {
      "source": "/REGISTER",
      "destination": "/register",
      "permanent": false
    },
    {
      "source": "/Bartender",
      "destination": "/bartender",
      "permanent": false
    },
    {
      "source": "/BARTENDER",
      "destination": "/bartender",
      "permanent": false
    }
  ]
}
